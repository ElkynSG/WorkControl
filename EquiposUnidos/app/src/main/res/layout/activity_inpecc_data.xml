<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo_logo"
    tools:context=".InspeccionPreoperacional.InpeccDataActivity">

    <LinearLayout
        android:id="@+id/layout0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.15"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTitleInspec"
            android:layout_width="350dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="60dp"
            android:gravity="center|bottom"
            android:text="INSPECCION PREOPERACION\nEXCAVADORA"
            android:textColor="@color/color_logo"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:gravity="center"
            android:layout_marginEnd="50dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FECHA Y HORA"
                android:textStyle="bold"
                android:textColor="@color/color_logo"
                android:textSize="20sp"/>

            <TextView
                android:id="@+id/fechct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_logo"
                android:text="30/04/2023  11:14:34"
                android:textSize="20sp"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imImaInspData"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/user_png" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"

                android:layout_marginEnd="20dp"
                android:layout_marginStart="10dp"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDataInOper"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_logo"
                        android:text="Operador:"/>

                    <TextView
                        android:id="@+id/spDataInOper"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="normal"
                        android:textColor="@color/color_logo"
                        android:text=""/>


                </LinearLayout>
                <LinearLayout
                    android:id="@+id/liCedulaInp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:visibility="visible"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_logo"
                        android:text="Cedula:"/>

                    <TextView
                        android:id="@+id/edDataInCedula"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="normal"
                        android:textColor="@color/color_logo"
                        android:text=""/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="30dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="5dp"
                    android:background="#444"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_logo"
                        android:text="Supervisor:"/>

                    <Spinner
                        android:id="@+id/spDataInSuper"
                        android:layout_width="300dp"
                        android:backgroundTintMode="multiply"
                        android:foreground="@drawable/shape_spinner"
                        android:backgroundTint="#000"
                        android:layout_height="40dp" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:visibility="visible"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_logo"
                        android:text="Cedula:"/>

                    <TextView
                        android:id="@+id/tvCedulaSuper"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="normal"
                        android:textColor="@color/color_logo"
                        android:text=""/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="30dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="5dp"
                    android:background="#444"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHorometro"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:layout_gravity="center_vertical"
                        android:textStyle="bold"
                        android:textColor="@color/color_logo"
                        android:text="Horometro:"/>

                    <EditText
                        android:id="@+id/edDataInHorom"
                        android:layout_width="300dp"
                        android:layout_height="40dp"
                        android:background="@drawable/shape_editext"
                        android:inputType="numberDecimal"
                        android:paddingStart="10dp"
                        android:maxLength="20"
                        android:singleLine="true" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:layout_gravity="center_vertical"
                        android:textStyle="bold"
                        android:textColor="@color/color_logo"
                        android:text="Lugar:"/>

                    <Spinner
                        android:id="@+id/spDataInLugar"
                        android:layout_width="300dp"
                        android:backgroundTintMode="multiply"
                        android:foreground="@drawable/shape_spinner"
                        android:backgroundTint="#000"
                        android:layout_height="40dp" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_logo"
                        android:text="Observaciones:"/>


                </LinearLayout>

                <EditText
                    android:id="@+id/edDataInObserva"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/shape_editext"
                    android:inputType="text"
                    android:layout_marginBottom="5dp"
                    android:paddingStart="10dp"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="horizontal">

                    <TextView
                        android:text="Firma del Tecnico Responsable:"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.405"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/shape_firmas"
                        android:paddingStart="5dp"
                        android:textColor="@color/color_logo"
                        android:textSize="15sp"/>


                    <TextView
                        android:text="Firma del Supervisor Responsable:"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.405"
                        android:layout_marginStart="2dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/shape_firmas"
                        android:paddingStart="5dp"
                        android:textColor="@color/color_logo"
                        android:textSize="15sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    android:background="@color/white"
                    android:orientation="horizontal">


                    <ImageView
                        android:id="@+id/btTecnico"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="0.61"
                        android:layout_marginEnd="2dp"
                        android:paddingStart="5dp"
                        android:gravity="start"
                        android:background="@drawable/shape_firmas"/>

                    <ImageView
                        android:id="@+id/btSupervisor"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="0.61"
                        android:layout_marginStart="2dp"
                        android:paddingStart="5dp"
                        android:gravity="start"
                        android:background="@drawable/shape_firmas"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.15"
        android:gravity="bottom"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btContInGuardar"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/button_selector"
            android:text="INGRESAR"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btContInRegresa"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/button_selector"
            android:text="REGRESAR"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btContInHome"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/button_selector"
            android:text="HOME"
            android:textColor="@color/white"
            android:textSize="20sp" />


    </LinearLayout>

</LinearLayout>