<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorBlack"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.75"
        android:background="@color/white"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDescripList"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Fecha y Hora:"
            android:textColor="@color/color_logo"
            android:textSize="15sp"
            android:paddingStart="10dp"
            android:gravity="center_vertical"
            android:layout_margin="1dp"
            android:background="@color/white"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/lyPresion"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Izq"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:textColor="@color/color_logo"
                android:textSize="15sp"
                android:background="@color/white"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/edPresionIzq"
                android:layout_width="40dp"
                android:layout_marginStart="5dp"
                android:layout_height="wrap_content"
                android:maxLength="2"
                android:gravity="center"
                android:inputType="number"
                android:background="@drawable/shape_editext"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:text="Der"
                android:gravity="center_vertical"
                android:textColor="@color/color_logo"
                android:textSize="15sp"
                android:background="@color/white"
                android:textStyle="bold"  />
            <EditText
                android:id="@+id/edPresionDer"
                android:layout_width="40dp"
                android:maxLength="2"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:inputType="number"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_editext"/>

        </LinearLayout>


    </LinearLayout>



    <CheckBox
        android:id="@+id/cheList1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.1"
        android:background="@color/white"
        android:layout_margin="1dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>

    <CheckBox
        android:id="@+id/cheList2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.1"
        android:background="@color/white"
        android:layout_margin="1dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>

    <TextView
        android:id="@+id/tvMsgList"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.15"
        android:text="X"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:paddingStart="10dp"
        android:gravity="center"
        android:layout_margin="1dp"
        android:background="@color/white"
        android:textStyle="bold" />


</LinearLayout>